<h2>Registro: </h2>
{{#each erros}}
    <div class="alert alert-danger">
        {{texto}}
    </div>
{{else}}

{{/each}}
<div class="card">
    <div class="card-body">
        <form class="mt-5" action="/usuarios/registro" method="post">
    <label class="mb-2" for="nome">Nome:</label>
        <input type="text" name="nome" class="form-control mb-2" required>
    <label class="mb-2" for="email" >Email:</label>
        <input type="email" name="email" class="form-control mb-2" required>
    <label class="mb-2" for="senha">Senha:</label>
        <input type="password" name="senha" class="form-control mb-2" required>
    <label class="mb-2" for="senha2">Repetir senha:</label>
        <input type="password" name="senha2" class="form-control mb-4" required>
    <button type="submit" class="btn btn-success">Criar conta</button>
</form>
    </div>
</div>
