{{#each erros}}
    <div class="alert alert-danger">{{text}}</div>
    {{else}}

{{/each}}
<div class="card">
    <div class="card body">
        <h4 class="mb-4">Editar postagem: </h4>
        <form action="/admin/postagem/edit" method="post">
        <input type="hidden" value="{{postagem._id}}" name="id" >
            <label class="mb-2 mt-2" for="titulo">Titulo: </label>
            <input type="text" name="titulo" id="" class="form-control" required value="{{postagem.titulo}}">
            <label class="mb-2" for="slug">Slug: </label>
            <input type="text" class="form-control" name="slug" required value="{{postagem.slug}}">
            <label class="mb-2" for="descricao">Descrição: </label>
            <input type="text" class="form-control" name="descricao" required value="{{postagem.descricao}}">
            <label class="mb-2 mt-2" for="conteudo">Conteúdo: </label>
            <br>
            <textarea class="mb-2 mt-2 form-control" name="conteudo" id="" cols="30" rows="10" required>{{postagem.conteudo}}</textarea>
            <br>
            <label for="categoria">Categoria: </label>
            <br>
            <select class="mt-2 mb-2 form-select" name="categoria" id="">
                    {{#each categorias}}
                <option value="{{_id}}">{{nome}}</option>
                    {{else}}
                <option value="0">Nenhuma categoria registrada</option>
                    {{/each}}
            </select>
            <br>
            <button type="submit" class="btn btn-success mt-2">Editar</button>
        </form>
    </div>
</div>