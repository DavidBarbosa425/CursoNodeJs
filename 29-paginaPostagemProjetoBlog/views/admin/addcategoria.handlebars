{{#each erros}}
    <div class="alert alert-danger">{{texto}}</div>
{{else}}

{{/each}}
<h3>Nova categoria: </h3>

<form action="/admin/categorias/nova" method="post" class="text-success">
<label for="nome" class="text-white mb-2">nome: </label>
<input class="form-control" type="text" id="nome" name="nome" placeholder="Nome de categorias">
<label class="text-white mb-2 mt-2" for="slug">Slug: </label>
<input class="form-control" type="text" id="slug" name="slug" placeholder="slug da categoria">
<button class="mt-3 btn btn-success">Criar categoria</button>

</form>