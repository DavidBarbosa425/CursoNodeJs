{{#each erros}}
    <div class="alert alert-danger">{{texto}}</div>
{{else}}

{{/each}}
<h3>Editar categoria: </h3>

<form action="/admin/categorias/edit" method="post" class="text-success">
<input type="hidden" name="id" value="{{categoria._id}}">
<label for="nome" class="text-white mb-2">nome: </label>
<input class="form-control" type="text" id="nome" name="nome" placeholder="Nome de categorias" value="{{categoria.nome}}">
<label class="text-white mb-2 mt-2" for="slug">Slug: </label>
<input class="form-control" type="text" id="slug" name="slug" placeholder="slug da categoria" value='{{categoria.slug}}'>

    <button class="mt-3 btn btn-success">Editar categoria</button>

</form>